[Unit]
Description=Scenes film API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=scenes
Group=scenes
WorkingDirectory=/opt/scenes
EnvironmentFile=/etc/scenes/api.env
ExecStart=/usr/bin/node /opt/scenes/server/index.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
