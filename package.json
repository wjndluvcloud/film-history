{
  "name": "film-history",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --experimental-test-isolation=none --test",
    "preview": "vite preview",
    "api": "wrangler dev --config server/wrangler.jsonc --port 3001",
    "api:deploy": "wrangler deploy --config server/wrangler.jsonc",
    "api:check": "wrangler deploy --config server/wrangler.jsonc --dry-run --outdir dist/worker"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "miniflare": "^5.20261006.1-alpha",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.149.0"
  }
}
